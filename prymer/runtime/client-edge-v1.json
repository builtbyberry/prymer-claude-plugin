{
    "contract": "app.prymer.edge.connection",
    "version": 4,
    "platform": "darwin",
    "loopback_host": "127.0.0.1",
    "signing_team_id": "3A5B83E5D4",
    "client_session_header": "X-Prymer-Client-Session",
    "mcp_path": "/mcp",
    "lifecycle": {
        "path": "/lifecycle",
        "events": ["session-start", "stop", "pre-tool-use"],
        "max_body_bytes": 8192,
        "max_session_id_length": 512,
        "max_cwd_length": 4096,
        "max_tool_length": 512,
        "max_transcript_path_length": 1024,
        "content_consent": {
            "file": "content-consent-v1.json",
            "schema": "app.prymer.edge.content-consent",
            "version": 1,
            "clients": ["claude", "codex"]
        }
    },
    "pre_tool_use": {
        "path": "/pre-tool-use",
        "max_body_bytes": 1048576,
        "max_session_id_bytes": 512,
        "max_cwd_bytes": 4096,
        "max_tool_bytes": 512,
        "max_tool_use_id_bytes": 256,
        "max_permission_mode_bytes": 64,
        "max_reason_bytes": 2048,
        "record_pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,127}$",
        "decisions": ["allow", "block"],
        "clients": ["claude", "codex"],
        "save_config": {
            "file": "save-config-v1.json",
            "schema": "app.prymer.edge.save-config",
            "version": 1,
            "max_ttl_seconds": 180
        }
    },
    "discovery": {
        "schema": "app.prymer.edge.discovery",
        "ttl_seconds": 90,
        "keys": [
            "credential_path",
            "endpoint",
            "expires_at",
            "generation",
            "health_path",
            "helper_version",
            "instance_id",
            "lifecycle_path",
            "mcp_path",
            "pid",
            "published_at",
            "ready",
            "schema",
            "version"
        ]
    },
    "health": {
        "schema": "app.prymer.edge.health",
        "path": "/health",
        "keys": [
            "generation",
            "helper_version",
            "instance_id",
            "ready",
            "schema",
            "version"
        ]
    }
}
